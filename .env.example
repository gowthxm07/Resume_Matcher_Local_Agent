# CareerCrew Root Environment Configuration
# Local-First Architecture: ZERO paid API keys required

# Core App Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="CareerCrew"
APP_VERSION="0.1.0"

# Local LLM Provider (Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=120.0

# Database (SQLite)
DATABASE_URL=sqlite:///./data/database/careercrew.db

# Storage Directories
DATA_DIR=./data
UPLOAD_MAX_BYTES=10485760 # 10MB
ALLOWED_FILE_EXTENSIONS=[".pdf",".docx",".txt",".md"]

# Local Vector Store
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_DIR=./data/embeddings/chroma

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
